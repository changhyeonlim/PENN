# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=penn
CLICKHOUSE_SECURE=0

# Nebius Token Factory (OpenAI-compatible)
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
TOKEN_FACTORY_API_KEY=
# The model for every Ask PENN turn (default: Nemotron 3 Super). MODEL_CHAT overrides it to compare models.
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# MODEL_CHAT=

# City AIS geocoder (verify whether a key is required)
AIS_GATEKEEPER_KEY=

# Ticketmaster Discovery API consumer key (developer.ticketmaster.com)
TICKETMASTER_API_KEY=

# Tavily web search (tavily.com), the fallback for events PENN has no record of
TAVILY_API_KEY=

# Frontend
NEXT_PUBLIC_PENN_API=http://localhost:8000

# Public demo (deploy/endpoint): guardrails on, and the access code that gives judges their own allowance
# PENN_PUBLIC=1
PENN_JUDGE_CODE=

# Data bucket (deploy/data_bucket.py): the weekly hand-saved data, carried to the deployed container through
# any S3-compatible storage. Leave PENN_BUCKET empty to run without one.
PENN_BUCKET=
PENN_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
PENN_S3_REGION=us-east-1
PENN_S3_KEY_ID=
PENN_S3_SECRET=
